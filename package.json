{
    "name": "hm3",
    "private": true,
    "version": "1.6.3",
    "description": "The HârnMaster 3 system for Foundry VTT",
    "type": "module",
    "license": "SEE LICENSE IN LICENSE",
    "author": {
        "name": "Tom Rodriguez"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HeroicLands/HarnMaster-3-FoundryVTT.git"
    },
    "bugs": {
        "url": "https://github.com/HeroicLands/HarnMaster-3-FoundryVTT/issues"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "prepare": "git config core.hooksPath .githooks || true",
        "clean": "package-build clean",
        "build": "npm ci && npm run build:noci",
        "build:local": "npm i && npm run build:noci",
        "build:noci": "run-s build:css build:assets build:compiledb build:content-index lint:roundtrip build:system",
        "build:css": "sass --load-path=scss scss/hm3.scss build/stage/css/hm3.css",
        "watch:css": "sass --load-path=scss --watch scss/hm3.scss build/stage/css/hm3.css",
        "build:assets": "package-build assets",
        "build:compiledb": "node utils/compile-packs.mjs",
        "build:unpackdb": "node utils/unpack-packs.mjs",
        "build:system": "package-build manifest",
        "build:site": "run-s build:site-content build:site-html",
        "build:site-content": "content-build site",
        "build:site-html": "hugo --source site --minify --gc --cleanDestinationDir",
        "build:pack-release": "package-build release",
        "push:dev": "package-build deploy dev",
        "schema": "package-build schema",
        "deploy:dev": "run-s build:local push:dev",
        "lint": "run-s lint:format lint:markdown lint:addresses lint:content-links lint:lang lint:packs lint:schema",
        "lint:addresses": "content-build lint",
        "lint:content-links": "content-build links",
        "lint:format": "content-build format",
        "lint:lang": "package-build lang check",
        "lint:markdown": "content-build markdown",
        "lint:markdown:fix": "content-build markdown --fix",
        "lint:packs": "node utils/check-no-compiled-packs.mjs",
        "lint:roundtrip": "node utils/check-pack-roundtrip.mjs",
        "lint:schema": "package-build schema --check",
        "format": "content-build format --write",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "e2e:seed": "package-build e2e seed",
        "e2e:full": "package-build e2e run",
        "e2e:open": "package-build e2e open",
        "e2e:fast": "package-build e2e fast",
        "e2e:sweep": "package-build e2e sweep",
        "container:test": "package-build container test",
        "changeset": "changeset",
        "changeset:version": "changeset version && package-build schema && npm install --package-lock-only",
        "changeset:check": "changeset status --since=origin/main",
        "build:content-index": "content-build content-index"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.1",
        "@foundryvtt/foundryvtt-cli": "^3.0.4",
        "@heroiclands/hugo-theme": "^0.2.0",
        "@heroiclands/package-build": "^17.2.0",
        "cypress": "^15.21.1",
        "dotenv": "^17.4.2",
        "npm-run-all": "^4.1.5",
        "sass": "^1.103.1",
        "vitest": "^4.1.11"
    }
}
